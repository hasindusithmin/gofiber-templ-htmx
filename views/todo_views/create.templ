package todo_views

import (
	"github.com/gofiber/fiber/v2"
	"github.com/emarifer/gofiber-templ-htmx/views"
)

templ FormInput(label, name, inputType, extraClass string, required bool, attrs ...string) {
	<label class="flex flex-col gap-2">
		{label}:
		<input
			type={inputType}
			name={name}
			class={"input input-bordered input-primary bg-slate-800 " + extraClass}
			required={required}
			{range attrs}{.} {/range}
		/>
	</label>
}

templ FormTextarea(label, name, extraClass string, maxLength int) {
	<label class="flex flex-col gap-2">
		{label}:
		<textarea
			name={name}
			class={"textarea textarea-primary bg-slate-800 " + extraClass}
			maxlength={maxLength}
		></textarea>
	</label>
}

templ CreateIndex() {
	<h1 class="text-2xl font-bold text-center mb-8">Enter Task</h1>
	<section class="max-w-2xl w-4/5 h-96 mx-auto bg-slate-600 rounded-lg shadow-xl">
		<form class="flex flex-col gap-4 w-11/12 p-4 mx-auto rounded-xl" method="post">
			@FormInput("Title", "title", "text", "", true, "autofocus", "minlength=3", "maxlength=64")
			@FormTextarea("Description", "description", "h-36 max-h-36", 255)
			<footer class="flex gap-4 justify-end">
				<button class="badge badge-primary p-4 hover:scale-[1.1]">Save</button>
				<a href="/todo/list" class="badge badge-neutral p-4 hover:scale-[1.1]">Cancel</a>
			</footer>
		</form>
	</section>
}

templ Create(
	page string,
	fromProtected, isError bool,
	msg fiber.Map,
	username string,
	cmp templ.Component,
) {
	@views.Layout(page, fromProtected, isError, msg, username) {
		@cmp
	}
}
